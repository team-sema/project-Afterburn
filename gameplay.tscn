[node name="WeaponSlotSelectionOverlay" parent="." instance=ExtResource("11_slot")]

[node name="WeaponAcquireConfirmOverlay" parent="." instance=ExtResource("12_confirm")]

[node name="WeaponAcquisitionController" type="Node" parent="." node_paths=PackedStringArray("ship", "slot_selection_ui", "confirm_ui")]
script = ExtResource("13_acquisition")
ship = NodePath("../Ship")
slot_selection_ui = NodePath("../WeaponSlotSelectionOverlay")
confirm_ui = NodePath("../WeaponAcquireConfirmOverlay")

[node name="AugmentOfferController" type="Node" parent="." node_paths=PackedStringArray("player_registry", "enemy_registry", "selection_ui", "slot_selection_ui", "ship")]
script = ExtResource("8_offer")
player_registry = NodePath("../PlayerAugmentRegistry")
enemy_registry = NodePath("../EnemyAugmentRegistry")
selection_ui = NodePath("../AugmentSelectionOverlay")
slot_selection_ui = NodePath("../WeaponSlotSelectionOverlay")
ship = NodePath("../Ship")
player_augment_pool = Array[ExtResource("14_player_augment")]([ExtResource("16_player_move"), ExtResource("17_player_fire"), ExtResource("18_player_damage"), ExtResource("22_up_main"), ExtResource("23_up_aux")])
enemy_augment_pool = Array[ExtResource("15_enemy_augment")]([ExtResource("19_enemy_health"), ExtResource("20_enemy_counter"), ExtResource("21_enemy_move")])

[node name="ScoreAugmentOfferTrigger" type="Node" parent="." node_paths=PackedStringArray("offer_controller")]
script = ExtResource("9_trigger")
game_stats = ExtResource("3_stats")
offer_controller = NodePath("../AugmentOfferController")
first_offer_score = 10
score_interval = 100

[node name="Ship" parent="." node_paths=PackedStringArray("augment_registry") instance=ExtResource("2_ship")]
position = Vector2(80, 216)
augment_registry = NodePath("../PlayerAugmentRegistry")

[node name="SpaceBackground" parent="." instance=ExtResource("4_background")]

[node name="EnemyGenerator" parent="." node_paths=PackedStringArray("augment_registry") instance=ExtResource("5_generator")]
