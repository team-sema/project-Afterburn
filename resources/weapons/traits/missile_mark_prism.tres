[resource]
script = ExtResource("1_def")
trait_id = &"missile_mark_prism"
display_name = "표적 지정"
description = "미사일에 맞은 적에 {mark_duration}초 표식. 표식된 적은 모든 무기에게 받는 피해 ×{mark_damage_mult}. 미사일은 표식 없는 적을 먼저 노립니다. 미사일 피해 ×{damage_mult}."
icon = ExtResource("2_icon")
target_weapon_id = &"aux_homing_missile"
tier = 2
max_rank = 1
params = {
"damage_mult": 0.5,
"mark_damage_mult": 1.3,
"mark_duration": 4.0
}
rank_overrides = Array[Dictionary]([])
