[gd_resource type="Resource" script_class="EncounterWave" load_steps=4 format=3]

[ext_resource type="Script" path="res://resources/encounter_sequences/encounter_wave.gd" id="1_wave_script"]
[ext_resource type="Script" path="res://resources/encounters/encounter_preset.gd" id="2_preset_script"]
[ext_resource type="Resource" path="res://resources/encounters/presets/drone_straight_formation.tres" id="3_drone_straight"]

[resource]
script = ExtResource("1_wave_script")
wave_id = &"drone_swarm_wave"
encounter_presets = Array[ExtResource("2_preset_script")]([ExtResource("3_drone_straight")])
interval_min = 1.0
interval_max = 1.0
