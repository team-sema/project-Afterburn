; WAVE(b)용 연속 편대 묶음.
; encounter_preset_paths를 앞에서부터 스폰하고, 사이마다 interval(초)을 쉰다.
; 편대는 경로를 한 줄에 하나씩 — ExtResource 배열 한 줄 지옥을 피한다.
[gd_resource type="Resource" script_class="EncounterWave" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/encounter_sequences/encounter_wave.gd" id="1_wave_script"]

[resource]
script = ExtResource("1_wave_script")
wave_id = &"drone_swarm_wave"
encounter_preset_paths = PackedStringArray("res://resources/encounters/presets/drone_straight_formation.tres", "res://resources/encounters/presets/drone_triangle_formation.tres", "res://resources/encounters/presets/drone_zigzag_formation.tres")
interval_min = 1.0
interval_max = 1.2
