[gd_resource type="Resource" script_class="EncounterSequence" format=3 uid="uid://bf4bjis04cgmf"]

[ext_resource type="Script" uid="uid://c4uhcnakyaq0q" path="res://resources/encounter_sequences/encounter_sequence.gd" id="1_sequence_script"]
[ext_resource type="Script" uid="uid://ccvva2lwj2nr3" path="res://resources/encounter_sequences/encounter_sequence_step.gd" id="2_step_script"]
[ext_resource type="Script" uid="uid://d3271fkn4umf1" path="res://resources/encounter_sequences/encounter_sequence_phase.gd" id="3_phase_script"]
[ext_resource type="Resource" uid="uid://bx6mvihopc5mq" path="res://resources/encounters/pools/main_encounter_pool.tres" id="4_main_pool"]
[ext_resource type="Script" uid="uid://c6t14vfypdxop" path="res://resources/encounters/encounter_preset.gd" id="5_1p4mw"]
[ext_resource type="Resource" path="res://resources/encounter_sequences/waves/drone_swarm_wave.tres" id="5_drone_swarm_wave"]

[sub_resource type="Resource" id="Resource_phase_main"]
script = ExtResource("3_phase_script")
phase_id = &"main"
pattern = "a a a a b a a a b a a a c a a a a b a a a a d"

[sub_resource type="Resource" id="Resource_step_a"]
script = ExtResource("2_step_script")
token = &"a"
encounter_pool = ExtResource("4_main_pool")

[sub_resource type="Resource" id="Resource_step_b"]
script = ExtResource("2_step_script")
token = &"b"
kind = 1
post_delay_min = 5.0
post_delay_max = 5.5
wave = ExtResource("5_drone_swarm_wave")
clear_timeout = 6.0
clear_min_wait = 2.5

[sub_resource type="Resource" id="Resource_step_c"]
script = ExtResource("2_step_script")
token = &"c"
kind = 2

[sub_resource type="Resource" id="Resource_step_d"]
script = ExtResource("2_step_script")
token = &"d"
kind = 3

[resource]
script = ExtResource("1_sequence_script")
sequence_id = &"main_encounter_sequence"
shared_steps = Array[ExtResource("2_step_script")]([SubResource("Resource_step_a"), SubResource("Resource_step_b"), SubResource("Resource_step_c"), SubResource("Resource_step_d")])
phases = Array[ExtResource("3_phase_script")]([SubResource("Resource_phase_main")])
