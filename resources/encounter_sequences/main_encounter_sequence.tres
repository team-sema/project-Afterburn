[sub_resource type="Resource" id="Resource_phase_lesson_1"]
script = ExtResource("3_phase_script")
phase_id = &"lesson_1"
pattern = "L a H a W a c"

[sub_resource type="Resource" id="Resource_phase_lesson_2"]
script = ExtResource("3_phase_script")
phase_id = &"lesson_2"
pattern = "S a B a G a a c"

[sub_resource type="Resource" id="Resource_phase_lesson_3"]
script = ExtResource("3_phase_script")
phase_id = &"lesson_3"
pattern = "F a D a a a c d"

[sub_resource type="Resource" id="Resource_phase_mix"]
script = ExtResource("3_phase_script")
phase_id = &"mix"
pattern = "a a S a a F a a c a a B a a G a a D a a d"

[sub_resource type="Resource" id="Resource_step_a"]
script = ExtResource("2_step_script")
token = &"a"
encounter_pool = ExtResource("4_main_pool")

[sub_resource type="Resource" id="Resource_step_L"]
script = ExtResource("2_step_script")
token = &"L"
kind = 1
post_delay_min = 3.0
post_delay_max = 3.4
waves = Array[ExtResource("5_wave_script")]([ExtResource("w_lesson_aim_a"), ExtResource("w_lesson_aim_b")])
clear_timeout = 6.0
clear_min_wait = 3.0

[sub_resource type="Resource" id="Resource_step_H"]
