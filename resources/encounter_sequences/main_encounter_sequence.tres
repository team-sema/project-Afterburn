[resource]
script = ExtResource("1_sequence_script")
sequence_id = &"main_encounter_sequence"
shared_steps = Array[ExtResource("2_step_script")]([SubResource("Resource_step_a"), SubResource("Resource_step_L"), SubResource("Resource_step_H"), SubResource("Resource_step_W"), SubResource("Resource_step_S"), SubResource("Resource_step_B"), SubResource("Resource_step_G"), SubResource("Resource_step_F"), SubResource("Resource_step_D"), SubResource("Resource_step_c"), SubResource("Resource_step_d")])
phases = Array[ExtResource("3_phase_script")]([SubResource("Resource_phase_lesson_1"), SubResource("Resource_phase_lesson_2"), SubResource("Resource_phase_lesson_3"), SubResource("Resource_phase_mix")])
