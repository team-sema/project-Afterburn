[gd_resource type="Resource" script_class="MovementSequence" load_steps=5 format=3]

[ext_resource type="Script" path="res://resources/enemy_movement/movement_sequence.gd" id="1_sequence"]
[ext_resource type="Script" path="res://resources/enemy_movement/movement_step.gd" id="2_step"]
[ext_resource type="Script" path="res://resources/enemy_movement/steps/sine_movement_step.gd" id="3_sine"]

[sub_resource type="Resource" id="Sine_zigzag"]
script = ExtResource("3_sine")
forward_direction = Vector2(0, 1)
forward_speed = 60.0
amplitude = 32.0
period = 1.5
lateral_sign_context_key = &"lateral_sign"

[resource]
script = ExtResource("1_sequence")
steps = Array[ExtResource("2_step")]([SubResource("Sine_zigzag")])
