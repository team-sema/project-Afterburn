[gd_resource type="Resource" script_class="MovementSequence" load_steps=7 format=3]

[ext_resource type="Script" path="res://resources/enemy_movement/movement_sequence.gd" id="1_sequence"]
[ext_resource type="Script" path="res://resources/enemy_movement/movement_step.gd" id="2_step"]
[ext_resource type="Script" path="res://resources/enemy_movement/steps/move_to_position_step.gd" id="3_move_to"]
[ext_resource type="Script" path="res://resources/enemy_movement/steps/wait_movement_step.gd" id="4_wait"]

[sub_resource type="Resource" id="MoveTo_upper"]
script = ExtResource("3_move_to")
